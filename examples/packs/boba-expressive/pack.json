{
  "name": "boba-expressive",
  "label": "Boba Expressive",
  "version": "1.0.0",
  "description": "An M3-Expressive-inspired FX set: violet/lavender tonal palette, pills that square up on exit, organic blobs, overshoot easings, and matte flatness (no glows or shadows).",
  "author": "Joe Lloyd",
  "category": "Expressive",
  "tags": ["m3", "expressive", "blob", "pill"],
  "entry": "index.tsx",
  "templates": [
    {
      "name": "BobaTitle",
      "label": "Boba Title",
      "description": "Display title with word-by-word expressive stagger and a blob-marked subtitle.",
      "defaultDurationSeconds": 5,
      "category": "Titles",
      "icon": "Type",
      "fields": [
        { "key": "title", "type": "text", "default": "Make it expressive" },
        { "key": "subtitle", "type": "text", "default": "A softer, rounder motion language" },
        { "key": "textColor", "type": "color", "default": "#ffffff" },
        { "key": "accentColor", "type": "color", "default": "#deb8f7" },
        { "key": "background", "type": "select", "default": "none", "options": ["none", "dark", "light"] },
        { "key": "align", "type": "select", "default": "left", "options": ["left", "center"] },
        { "key": "size", "type": "number", "default": 96, "min": 32, "max": 220 }
      ]
    },
    {
      "name": "BobaLowerThird",
      "label": "Boba Lower Third",
      "description": "Frosted pill lower third — center-out reveal, staggered text, squares up on exit.",
      "defaultDurationSeconds": 5,
      "category": "Lower thirds",
      "icon": "Clapperboard",
      "fields": [
        { "key": "title", "type": "text", "default": "Joe Lloyd" },
        { "key": "subtitle", "type": "text", "default": "Product Engineer" },
        { "key": "accentColor", "type": "color", "default": "#deb8f7" },
        { "key": "theme", "type": "select", "default": "dark", "options": ["dark", "light"] },
        { "key": "side", "type": "select", "default": "left", "options": ["left", "right"] }
      ]
    },
    {
      "name": "BobaTag",
      "label": "Boba Tag",
      "description": "Matte pill tag with the circle-to-pill clip reveal. Flat by design — no glow.",
      "defaultDurationSeconds": 4,
      "category": "Badges",
      "icon": "Tag",
      "fields": [
        { "key": "text", "type": "text", "default": "New" },
        { "key": "color", "type": "color", "default": "#deb8f7" },
        { "key": "textColor", "type": "color", "default": "#402357" },
        { "key": "size", "type": "number", "default": 40, "min": 12, "max": 160 },
        { "key": "corner", "type": "select", "default": "top-right", "options": ["top-left", "top-right", "bottom-left", "bottom-right"] }
      ]
    },
    {
      "name": "BobaBlob",
      "label": "Boba Blob",
      "description": "Organic blob shape that springs in with an overshoot; optional slow spin and breath.",
      "defaultDurationSeconds": 6,
      "category": "Shapes",
      "icon": "Flower2",
      "fields": [
        { "key": "shape", "type": "select", "default": "sunny", "options": ["sunny", "flower", "clover", "cookie", "oval"] },
        { "key": "color", "type": "color", "default": "#deb8f7" },
        { "key": "size", "type": "number", "default": 420, "min": 40, "max": 1080 },
        { "key": "spin", "type": "boolean", "default": true },
        { "key": "breath", "type": "boolean", "default": true }
      ]
    },
    {
      "name": "BobaMorphLoader",
      "label": "Boba Morph Loader",
      "description": "Brand-mark loader: a blob morphing through a shape sequence with rotation snaps.",
      "defaultDurationSeconds": 5,
      "category": "Loaders",
      "icon": "Loader2",
      "fields": [
        { "key": "color", "type": "color", "default": "#deb8f7" },
        { "key": "size", "type": "number", "default": 220, "min": 40, "max": 800 },
        { "key": "stepSeconds", "type": "number", "default": 1, "min": 0.5, "max": 3, "step": 0.1 }
      ]
    }
  ]
}
