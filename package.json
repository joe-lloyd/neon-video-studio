{
  "name": "neon-video-editor",
  "version": "0.6.6",
  "private": true,
  "description": "Neon Video Studio — Electrobun + Remotion desktop video editor with P2P (Yjs) sync and an agent-friendly CLI",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=10.16"
  },
  "scripts": {
    "dev": "pnpm --filter @neon/desktop dev",
    "dev:renderer": "pnpm --filter @neon/desktop dev:renderer",
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "cli": "node apps/cli/src/main.ts",
    "render:worker": "node packages/render/src/worker.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
