{
  "name": "@neon/render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Render pipeline: Node worker (bundle → metadata → @neon/motion renderMedia), spawn helper, headless asset server",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "build": "echo '@neon/render is consumed as TypeScript source'"
  },
  "dependencies": {
    "@neon/core": "workspace:*",
    "@neon/fx-kit": "workspace:*",
    "@neon/motion": "workspace:*",
    "@neon/compositions": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
